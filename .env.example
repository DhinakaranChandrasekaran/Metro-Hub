# ============================================
# MetroHub - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# .env is already in .gitignore
# ============================================

# ================================
# DATABASE
# ================================
# Local development:
DB_URL=jdbc:mysql://localhost:3306/metrohub_db?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Production (Aiven MySQL) - set these in Render dashboard:
# DB_URL=jdbc:mysql://<HOST>:<PORT>/metrohub_db?useSSL=true&requireSSL=true&serverTimezone=Asia/Kolkata
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_aiven_password

# ================================
# EMAIL (GMAIL SMTP)
# ================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=noreply@metrohub.local

# ================================
# AWS S3
# ================================
S3_BUCKET_NAME=your-s3-bucket-name
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key
S3_REGION=ap-south-2

# ================================
# JWT
# ================================
JWT_SECRET=YourSuperSecretKeyThatIsAtLeast256BitsLongForSecurity!

# ================================
# NOTIFICATIONS
# ================================
NOTIFICATIONS_EMAIL_ENABLED=true
NOTIFICATIONS_SMS_ENABLED=true

# ================================
# TWILIO (SMS)
# ================================
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# ================================
# SMS MOCK (set to false in production)
# ================================
SMS_MOCK_ENABLED=true

# ================================
# OCR (Tesseract)
# ================================
# Leave empty for auto-detection, or set path:
# Windows: C:\Program Files\Tesseract-OCR\tessdata
# Linux/Docker: /usr/share/tessdata
TESSDATA_PREFIX=

# ================================
# FRONTEND (Docker build arg)
# ================================
# URL of the backend API — baked into the React bundle at build time.
# Dev: http://localhost:8080/api
# Production: set to your public backend URL
REACT_APP_API_URL=http://localhost:8080/api

# ================================
# CORS
# ================================
# Dev (local):
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,http://localhost:8080
# Production — set this in your hosting dashboard (Render/Railway/etc):
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com

# ================================
# SPRING PROFILE
# ================================
# Leave empty for local dev (uses application.properties)
# Set to 'prod' in your hosting dashboard to activate application-prod.properties
# SPRING_PROFILES_ACTIVE=prod
